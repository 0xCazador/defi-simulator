{
  "name": "defi-simulator",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "next dev --webpack -p 8080",
    "build": "npm run sync_and_purge && next build --webpack",
    "analyze": "ANALYZE=true next build --webpack",
    "start": "next start -p 8080",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "jest": "jest",
    "jest:watch": "jest --watch",
    "prettier:check": "prettier --check \"**/*.{ts,tsx}\"",
    "prettier:write": "prettier --write \"**/*.{ts,tsx}\"",
    "preflight": "npm run prettier:check && npm run lint && npm run typecheck && npm run jest",
    "test": "npm run jest",
    "extract": "lingui extract",
    "compile": "lingui compile",
    "sync": "lingui extract --overwrite && lingui compile",
    "sync_and_purge": "lingui extract --overwrite --clean && lingui compile"
  },
  "dependencies": {
    "@aave-dao/aave-address-book": "^4.65.5",
    "@aave/contract-helpers": "1.38.0",
    "@aave/math-utils": "1.38.0",
    "@hookstate/core": "^4.0.2",
    "@lingui/core": "^6.6.0",
    "@lingui/react": "^6.6.0",
    "@mantine/core": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@mantine/notifications": "^9.5.1",
    "@netlify/blobs": "^10.7.13",
    "@next/bundle-analyzer": "^16.3.1",
    "accounting": "^0.4.1",
    "bignumber.js": "^9.3.1",
    "dayjs": "^1.11.21",
    "ethers": "^5.8.0",
    "jest-fetch-mock": "^4.2.0",
    "next": "^16.3.1",
    "nouislider": "^15.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "reflect-metadata": "^0.1.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@lingui/babel-plugin-lingui-macro": "^6.6.0",
    "@lingui/cli": "^6.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/accounting": "^0.4.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.5.26",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
